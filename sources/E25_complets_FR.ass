Dialogue: 0,0:23:05.49,0:23:10.41,ED Lyrics,,0,0,0,,{\fad(100,100)\fs65}Que j'aimerais faire
Dialogue: 0,0:23:10.41,0:23:14.71,ED Lyrics,,0,0,0,,{\fad(100,100)\fs65}Dans ma vie
Dialogue: 0,0:23:14.71,0:23:19.50,ED Lyrics,,0,0,0,,{\fad(100,100)\fs65}Je suis un rêveur
Dialogue: 0,0:23:19.50,0:23:24.72,ED Lyrics,,0,0,0,,{\fad(100,100)\fs65}Un lointain songeur
Dialogue: 0,0:23:24.72,0:23:30.22,ED Lyrics,,0,0,0,,{\fad(100,100)\fs65}Rêvant d'espoir
