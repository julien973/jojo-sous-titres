Dialogue: 0,0:01:42.58,0:01:44.71,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}ikiru imi o
Dialogue: 0,0:01:44.71,0:01:50.30,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}sekai ni nokosu kara
Dialogue: 0,0:01:51.09,0:01:53.05,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}Heaven’s falling down
Dialogue: 0,0:01:53.05,0:01:55.35,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}sora otoshite mo
Dialogue: 0,0:01:55.35,0:02:00.02,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}nozomi o kudakou kyouki no kami no
Dialogue: 0,0:02:00.02,0:02:02.02,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}Destiny is mine
Dialogue: 0,0:02:02.02,0:02:04.15,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}osore shitte mo
Dialogue: 0,0:02:04.15,0:02:08.61,OP3 Japanese,,0,0,0,,{\fad(100,100)\blur3}subete no mirai togirenu you ni
